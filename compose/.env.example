# AllArkive — environment configuration
#
# Copy this file to compose/.env and fill in your values before running
# docker compose. Never commit compose/.env to the repository.
#
#   cp compose/.env.example compose/.env
#   $EDITOR compose/.env


# ── Required ────────────────────────────────────────────────────────────────

# Secret key for Open WebUI session signing.
# Generate one with: openssl rand -hex 32
WEBUI_SECRET_KEY=


# ── Storage ─────────────────────────────────────────────────────────────────

# Root data directory. All ZIM files, models, vector index, and Open WebUI
# data live under this path. Ensure the filesystem has enough free space for
# your chosen bundle (see bundles/*/manifest.json for size estimates).
#
#   minimal bundle: ~4 GB + model (~2-5 GB)
#   balanced bundle: ~30 GB + model (~4 GB)
#   comprehensive bundle: 150+ GB + model
#
# On Pi deployments, point this at the USB SSD mount point.
ALLARKIVE_DATA_DIR=/var/lib/allarkive


# ── Ports ───────────────────────────────────────────────────────────────────
# All ports are bound to 127.0.0.1 (loopback only) by default.
# Do not change these to 0.0.0.0 without also setting up a reverse proxy
# with authentication. See docs/deployment/lan-access.md.

# kiwix-serve (archive viewer)
KIWIX_PORT=8081

# Ollama (model API)
OLLAMA_PORT=11434

# Open WebUI (chat interface)
WEBUI_PORT=3000

# RAG service — added in Milestone 4
# RAG_PORT=8000


# ── Open WebUI ───────────────────────────────────────────────────────────────

# Disable the login screen for single-user localhost installs.
# Set to "true" to require a username and password on every visit.
# Verify the correct env var name for the version pinned in docker-compose.yml.
WEBUI_AUTH=false

# Allow new users to sign up via the web UI.
# Only relevant when WEBUI_AUTH=true.
WEBUI_ENABLE_SIGNUP=false


# ── Ollama ───────────────────────────────────────────────────────────────────

# Model pulled automatically by bootstrap.sh.
# Open question: qwen2.5:7b vs llama3.1:8b vs mistral — see TODO.md.
OLLAMA_DEFAULT_MODEL=qwen2.5:7b


# ── Pi overrides (ignored unless using docker-compose.pi.yml) ────────────────

# Memory cap for Ollama on low-RAM devices.
# Tune down to 2G for Raspberry Pi 4 with 4 GB RAM.
OLLAMA_MEMORY_LIMIT=4G
