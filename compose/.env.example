# AllArkive — environment configuration
#
# Copy this file to compose/.env and fill in your values before running
# docker compose. Never commit compose/.env to the repository.
#
#   cp compose/.env.example compose/.env
#   $EDITOR compose/.env


# ── Required ────────────────────────────────────────────────────────────────

# Secret key for Open WebUI session signing.
# Generate one with: openssl rand -hex 32
WEBUI_SECRET_KEY=


# ── Storage ─────────────────────────────────────────────────────────────────

# Root data directory — used as the base when no per-subsystem path is set.
# On Pi deployments, point this at the USB SSD mount point.
#
#   minimal bundle: ~4 GB ZIMs + model (~2-5 GB)
#   balanced bundle: ~30 GB ZIMs + model (~4 GB)
#   comprehensive bundle: 150+ GB ZIMs + model
ALLARKIVE_DATA_DIR=/var/lib/allarkive

# Per-subsystem storage overrides.
# Leave blank to use ALLARKIVE_DATA_DIR/<subdir> (the default).
# Set these to put ZIMs on an external disk while keeping models internal,
# or to spread storage across multiple drives.
#
# bootstrap.sh writes the resolved paths here automatically when you pass
# --zim-dir / --models-dir / --index-dir, or after editing config.json at
# ~/.config/allarkive/config.json.
#
# Example — ZIMs on an external SSD, everything else internal:
#   ALLARKIVE_ZIM_DIR=/Volumes/ArchiveSSD/allarkive/zim
#   ALLARKIVE_MODELS_DIR=/Users/you/allarkive-data/models
ALLARKIVE_ZIM_DIR=
ALLARKIVE_MODELS_DIR=
ALLARKIVE_INDEX_DIR=
ALLARKIVE_WEBUI_DIR=


# ── Ports ───────────────────────────────────────────────────────────────────
# All ports are bound to 127.0.0.1 (loopback only) by default.
# Do not change these to 0.0.0.0 without also setting up a reverse proxy
# with authentication. See docs/deployment/lan-access.md.

# Landing page (local entry point)
LANDING_PORT=8080

# kiwix-serve (archive viewer)
KIWIX_PORT=8081

# Ollama (model API)
OLLAMA_PORT=11434

# Open WebUI (chat interface)
WEBUI_PORT=3000

# RAG service
RAG_PORT=8000


# ── Open WebUI ───────────────────────────────────────────────────────────────

# Disable the login screen for single-user localhost installs.
# Set to "true" to require a username and password on every visit.
# Verify the correct env var name for the version pinned in docker-compose.yml.
WEBUI_AUTH=false

# Allow new users to sign up via the web UI.
# Only relevant when WEBUI_AUTH=true.
WEBUI_ENABLE_SIGNUP=false


# ── Ollama ───────────────────────────────────────────────────────────────────

# If Ollama is already running natively (e.g. the macOS app), set these to use
# it instead of the Docker Ollama service. bootstrap.sh sets them automatically
# when it detects a local Ollama on port 11434.
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_URL=

# Chat model pulled automatically by bootstrap.sh.
OLLAMA_DEFAULT_MODEL=qwen2.5:7b


# ── RAG pipeline ─────────────────────────────────────────────────────────────

# Profile preset — bundles sensible defaults for the rest of the RAG knobs.
# Pick one of: pi, laptop, workstation.
#   pi          chunk=2000, int8 vectors, hybrid mode on (BM25 for ZIMs ≥ 4 GB),
#               batch=16. Designed for Raspberry Pi 4/5 on USB SSD.
#   laptop      chunk=2000, int8 vectors, dense everywhere, batch=64. Default.
#   workstation chunk=1500, float32 vectors, dense everywhere, batch=128.
# Individual RAG_* vars below override the preset's defaults.
RAG_PROFILE=laptop

# Embedding model used to index ZIM content and embed queries.
# Must be pulled by bootstrap.sh before running the indexer.
EMBED_MODEL=nomic-embed-text

# Chat model the RAG service forwards to Ollama. Must match OLLAMA_DEFAULT_MODEL
# or another model you have pulled.
CHAT_MODEL=qwen2.5:7b

# Vector storage format. int8 is 4x smaller than float32 with <1 point MTEB
# recall drop; recommended default. float32 is the legacy v0.1 format.
RAG_QUANTIZATION=int8

# Indexing chunk size (characters) and overlap. Larger chunks = fewer rows,
# better recall on long-form articles, fewer embed round-trips. Empty = use
# the profile preset's value.
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=

# Number of chunks sent to Ollama's /api/embed endpoint per request. Higher
# saturates a GPU; on Pi keep this small (8–16). Empty = profile preset.
RAG_BATCH_SIZE=

# Hybrid retrieval: when 1, ZIMs at or above RAG_HYBRID_THRESHOLD_GB are NOT
# dense-indexed. The server queries them via libzim's built-in Xapian
# full-text index at request time and merges with dense top-K via RRF. Saves
# indexing time entirely on multi-100-GB archives. Default profile decides.
RAG_HYBRID=
RAG_HYBRID_THRESHOLD_GB=

# Number of passages retrieved per query.
RAG_TOP_K=5
# Number of BM25 candidates pulled from each hybrid ZIM before RRF merge.
RAG_BM25_K=5

# Maximum L2 distance (on unit-normalised vectors) for a passage to be considered
# relevant. Increase to broaden recall; decrease to tighten precision.
RAG_MAX_DISTANCE=1.0

# Maximum articles indexed per ZIM file. Full Wikipedia has millions of articles;
# the default caps indexing time to something reasonable on first run.
# Increase after confirming your hardware can handle it. 0 = unlimited.
RAG_MAX_ARTICLES=0

# Public base URL for kiwix-serve. Used to generate clickable citation links.
# Change only if you've configured a custom hostname or LAN access.
KIWIX_PUBLIC_URL=http://127.0.0.1:8081

# Internal API key for the RAG service (used by Open WebUI; not a security boundary).
RAG_API_KEY=allarkive


# ── Pi overrides (ignored unless using docker-compose.pi.yml) ────────────────

# Memory cap for Ollama on low-RAM devices.
# Tune down to 2G for Raspberry Pi 4 with 4 GB RAM.
OLLAMA_MEMORY_LIMIT=4G
